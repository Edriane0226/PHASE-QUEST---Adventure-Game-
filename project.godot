; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phase Quest"
config/version="1.0.0"
run/main_scene="res://UI/Menus/MainMenuPanel.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UITheme="*res://Scripts/Autoload/ui_theme.gd"
GameAudio="*res://Scripts/Autoload/audio_manager.gd"
PlayerSave="*res://Scripts/Autoload/player_save.gd"
SceneTransition="*res://Scripts/Autoload/scene_transition.gd"

[display]

window/frame_pacing/android/swappy_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/viewport_width.android=1280
window/size/viewport_height.android=720

