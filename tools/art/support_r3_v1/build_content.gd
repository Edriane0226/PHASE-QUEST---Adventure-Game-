extends SceneTree
## Deterministic asset/default-state catalog. Never instantiates a campaign/save service.
const RULES=preload("res://Scripts/Content/phase_transition_rules.gd")
const QUESTIONS=preload("res://Scripts/Content/level_questions.gd")
const LEVELS=preload("res://Scripts/Content/level_registry.gd")
const LESSONS=preload("res://Scripts/UI/mechanic_visual.gd")
const BADGES=preload("res://Scripts/Autoload/achievement_registry.gd")
var panels: Dictionary={}
var output: String

func page(id: String,title: String,body: String,actions: Array=[],extra: Dictionary={}) -> void:
	var value:={"id":id,"title":title,"body":body,"actions":actions,"owner":"R3 010","origin":"R3 proposed presentation copy; not an integrated lesson/progression controller","family":id.get_slice(".",0)}
	value.merge(extra,true);panels[id]=value
func action(id: String,label: String,enabled:=true) -> Dictionary:return {"id":id,"label":label,"enabled":enabled}
func write(name: String,value: Dictionary) -> void:
	var file:=FileAccess.open(output.path_join(name),FileAccess.WRITE);file.store_string(JSON.stringify(value,"\t"));file.close()
func _initialize() -> void:call_deferred("build")
func build() -> void:
	output=ProjectSettings.globalize_path("res://assets/ui/support/r3_v1")
	DirAccess.make_dir_recursive_absolute(output)
	var cast: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://assets/characters/professors/r3_v1/cast_registry.json")).actors
	var portrait_index: Dictionary={}
	for role: String in cast:
		var portraits: Dictionary={}
		for key: String in cast[role].portraits:portraits[key.replace(role+"_portrait_","")]=cast[role].portraits[key]
		portrait_index[role]={"name":cast[role].display_name,"character_id":cast[role].character_id,"portraits":portraits}
	write("portrait-index.json",{"roles":portrait_index,"legacy_aliases":{"professor":"professor_z1"}})
	write("retained-content.json",{"question_banks":QUESTIONS.BANKS,"registered_levels":LEVELS.LEVELS,"guide_lessons":LESSONS.LESSONS,"puzzle_explanations":LESSONS.PUZZLE_EXPLANATIONS,"achievements":BADGES.DEFINITIONS,"rank_names":["Apprentice","Researcher","Phase Master"],"rank_ranges":["0–6 stars","7–12 stars","13–18 stars"],"authority":"Read-only originals, including historical wording; source hashes and explicit conflict/adaptation notes remain separate."})
	var intro:={"professor_z1":"Solid ice gains heat and becomes liquid water. This is melting: the substance remains water.","professor_z2":"Liquid water can become gas by evaporation at its surface or boiling throughout the liquid. Cooling water vapor can form liquid droplets.","professor_z3":"In suitable controlled conditions, solid water changes directly to gas, or vapor directly to frost. These paths have no intermediate liquid. Keep the apparatus contained."}
	for role: String in intro:
		page("dialogue."+role,"A field lesson",intro[role],[action("continue","Continue")],{"speaker":role,"expression":"explaining","diagram":{"professor_z1":"melting","professor_z2":"evaporation","professor_z3":"sublimation"}[role]})
	page("dialogue.instruction","Use the device","Select an available mode. Face a nearby suitable sample; hold Fire with a clear path. Release to stop.",[action("return","Return")],{"speaker":"professor_z1","expression":"neutral"})
	page("dialogue.first_success","A new discovery",LESSONS.PUZZLE_EXPLANATIONS.melt_direct,[action("acknowledge","Understood")],{"speaker":"professor_z1","expression":"happy","diagram":"melting","origin":"Retained exact PUZZLE_EXPLANATIONS.melt_direct; display/ack intent only","close_action":"acknowledge"})
	page("dialogue.pending","Continue your discovery","Your explanation is ready. Read it when you are safely back, then acknowledge it. It remains pending until acknowledgement is saved.",[action("read","Read explanation"),action("later","Later")],{"speaker":"professor_z1"})
	page("dialogue.ack_error","Acknowledgement not saved",LESSONS.PUZZLE_EXPLANATIONS.melt_direct+"\n\nYour acknowledgement could not be saved. Retry to keep this discovery recorded.",[action("retry_ack","Retry acknowledgement")],{"speaker":"professor_z1","expression":"cold","tone":"error","can_close":false,"status":"Not saved"})
	page("dialogue.long","A careful explanation",intro.professor_z3+"\n\n"+intro.professor_z2+"\n\n"+intro.professor_z1,[action("continue","Continue")],{"speaker":"professor_z3","expression":"concerned"})
	page("guides.empty","Guides","No Guides discovered yet. Speak to the Professor or observe a lesson. Help and demonstrations are free.",[action("help","Ask for help"),action("return","Return")],{"search":true,"rows":[]})
	var guide_rows: Array=[]
	for key: String in RULES.PROCESSES:guide_rows.append({"id":key,"title":key.capitalize(),"text":"Discovered lesson · Replay demonstration","action":"open_guide"})
	page("guides.library","Discovered Guides","Free help · unlimited replay. Demonstrations never complete the live puzzle.",[action("return","Return")],{"search":true,"rows":guide_rows})
	page("guides.no_results","Guides","No matching Guides. Clear your search or try another word.",[action("clear_search","Clear search"),action("return","Return")],{"search":true,"search_text":"unmatched topic"})
	page("guides.locked","Lesson not discovered","Speak to this zone's Professor and follow its introduction. You can revisit previously discovered Guides at any time.",[action("return","Return")],{"rows":[{"id":"future","title":"Undiscovered lesson","text":"Not yet discovered","enabled":false}]})
	page("help.contextual","Need a hand?","Face nearby first ice with a clear path; hold Fire to add heat. Release to stop. Solid ice melts into liquid water.",[action("demo","Show demonstration"),action("return","Return")],{"speaker":"professor_z1","diagram":"melting","status":"Free help · unlimited","origin":"R2 device-first help adapted from expedition_learning_support; old wedge position removed"})
	page("help.mechanical","Resonance bells","The bells shake the ice dam apart. This is mechanical fracture, not a melting observation.",[action("demo","Show demonstration"),action("return","Return")],{"speaker":"professor_z1","origin":"Current frozen_mill_campaign description; legacy campaign_support furnace/melting wording retained only in source/conflict log"})
	for key: String in RULES.PROCESSES:
		var rule: Dictionary=RULES.PROCESSES[key]
		var note:="%s → %s. Heat flows %s. The substance remains water."%[rule.from.capitalize(),rule.to,rule.heat]
		if key in ["sublimation","deposition"]:note+=" Suitable controlled chamber conditions are required. There is no intermediate liquid."
		if key=="deposition":note+=" Deposited frost is a measured sample, not a load-bearing platform."
		if key=="evaporation":note+=" Evaporation occurs at the surface; it does not require bubbles throughout the liquid."
		if key=="boiling":note+=" Vapor bubbles form throughout the liquid under suitable boiling conditions."
		if "gas" in [rule.from,rule.to]:note+=" Water vapor is invisible; dots in this particle diagram are a model."
		page("science."+key,key.capitalize(),note,[action("demo_previous","Previous step"),action("demo_next","Next step"),action("return","Return")],{"diagram":key,"demo_stage":0,"status":"Step 1 of 3","origin":"Endpoints/heat from actual phase_transition_rules; new explanatory model copy pending teacher review"})
	for state in ["ready","stepping","paused","complete","unavailable"]:
		page("demo."+state,"Replay demonstration","Use the labeled steps to compare the sample before heat transfer and afterward. Replays are free and do not solve your live task.",[action("demo_replay","Replay",state!="unavailable"),action("demo_next","Next step",state!="unavailable"),action("return","Return")],{"diagram":"melting" if state!="unavailable" else "","demo_stage":2 if state=="complete" else 1 if state=="stepping" else 0,"status":{"ready":"Ready","stepping":"Step 2 of 3","paused":"Paused","complete":"Demonstration complete","unavailable":"Demonstration unavailable; read the Guide instead"}[state]})
	var question: Dictionary=LEVELS.LEVELS["melting_and_freezing:1"].practice_question
	var choices: Array=[]
	for i in question.choices.size():choices.append({"id":str(i),"label":question.choices[i]})
	for state in ["unanswered","correct","incorrect","retry","saving"]:
		page("answer."+state,"Observe melting",question.text,[action("submit","Check answer",state!="saving"),action("return","Return")],{"choices":choices,"selected_choice":"0" if state=="correct" else "1" if state in ["incorrect","retry"] else "","feedback":("Correct. " if state=="correct" else "Try again. ")+question.feedback if state in ["correct","incorrect","retry"] else "","feedback_tone":"success" if state=="correct" else "error","status":"Saving answer…" if state=="saving" else "Practice · free feedback","origin":"Exact current registered L1 practice question/choices/feedback; layout-state selection is a fixture"})
	for i in 3:
		page("journal.rank_"+str(i),"Adventure ranks","One star per unique completed subregion. Replaying a completion does not add another star.",[action("guides","Guides"),action("badges","Badges"),action("return","Return")],{"rank_index":i,"status":["Apprentice · 0–6 stars","Researcher · 7–12 stars","Phase Master · 13–18 stars"][i],"rows":[{"title":"Progress","text":["0 / 18 subregions complete","7 / 18 subregions complete","18 / 18 subregions complete"][i]}]})
	page("journal.empty","Field Journal","Complete a subregion to add its discoveries. Unfinished puzzles are not shown as completed memories.",[action("guides","Guides"),action("return","Return")])
	page("journal.notes","Field Journal",LESSONS.PUZZLE_EXPLANATIONS.melt_direct,[action("demo_replay","Replay discovery"),action("return","Return")],{"diagram":"melting","status":"Completed discovery · The Melting Garden","origin":"Retained exact first melting explanation; completed-state fixture only"})
	for state in ["locked","hidden","partial","earned"]:
		var records: Array=[]
		for definition: Dictionary in BADGES.DEFINITIONS:records.append({"id":definition.id,"earned":state=="earned","count":1 if state=="partial" else 0})
		page("badges."+state,"Achievements","Adventure ranks and collectible badges are separate. Only verified gameplay evidence earns a badge.",[action("return","Return")],{"badges":records,"status":"32 / 32 earned" if state=="earned" else "0 / 32 earned","origin":"All32actual achievement IDs/predicates retained; earned/count state is disposable presentation data"})
	var recipes:={"z1":["Three plank bundles","Rope","Sailcloth","Rudder"],"z2":["Boiler shell","Turbine cartridge","Condenser coil","Return tank","Drive belt"],"z3":["Housing","Plate","Tube","Sensor","Ice","Port"]}
	var crafts:={"z1":"Boat assembly","z2":"Skybridge engine","z3":"Phase cartridge"}
	for zone: String in recipes:
		for state in ["missing","fitted","tested"]:
			var parts: Array=[]
			for item: String in recipes[zone]:parts.append({"title":item,"text":"Missing · locate part" if state=="missing" else "Fitted to matching slot"})
			page("craft."+zone+"_"+state,crafts[zone],"Recover parts → fit matching slots → operate and test → answer Finn → use the travel device."+(" Deposit the measured sample, then use the scanner after Finn." if zone=="z3" else ""),[action("test","Test assembly",state=="fitted"),action("finn","Speak to Finn",state=="tested"),action("return","Return")],{"rows":parts,"status":{"missing":"Recipe available · parts missing","fitted":"Assembly ready for test","tested":"Craft test complete"}[state],"origin":"R3 master planned capstone recipe; asset contract only, no live item/inventory consumption"})
	for state in ["wrong_part","canceled","test_failed","save_error"]:
		page("craft."+state,"Assembly workshop",{"wrong_part":"This part does not match that slot. Return it unchanged and inspect the matching shape.","canceled":"Assembly paused. Fitted parts and remaining inventory are preserved.","test_failed":"The test is incomplete. Check the apparatus and retry; your existing parts are preserved.","save_error":"Assembly could not be saved. Retry before leaving; no success or reward is confirmed."}[state],[action("retry","Retry"),action("return","Return",state!="save_error")],{"tone":"error" if state in ["test_failed","save_error"] else "neutral","can_close":state!="save_error"})
	page("finn.wait","Finn","Finish the craft test first. Then we can discuss what you observed.",[action("recipe","View recipe"),action("return","Return")],{"speaker":"finn","expression":"neutral","status":"Questions follow the tested craft"})
	for zone in [1,2,3]:
		var count: int={1:3,2:4,3:6}[zone]
		for state in ["question","passed"]:
			page("finn.z%d_%s"%[zone,state],"Finn's field questions",question.text if state=="question" else "All required questions are answered. Use the tested travel device to finish this capstone.",[action("submit","Check answer") if state=="question" else action("return","Return to workshop"),action("help","Ask for help")],{"speaker":"finn","expression":"explaining" if state=="question" else "happy","choices":choices if state=="question" else [],"status":"Question 1 / %d"%count if state=="question" else "%d / %d passed · first attempts recorded separately"%[count,count],"origin":"R3 planned3/4/6pass counts; actual L1 practice text used only as layout specimen, not final Finn question bank"})
	for state in ["wrong","correct","resumed","save_error"]:
		page("finn."+state,"Finn's field questions",question.text,[action("retry","Try again") if state=="wrong" else action("continue","Continue"),action("help","Ask for help")],{"speaker":"finn","expression":"concerned" if state in ["wrong","save_error"] else "happy" if state=="correct" else "neutral","choices":choices,"selected_choice":"1" if state=="wrong" else "0","feedback":("Try again. " if state=="wrong" else "Correct. ")+question.feedback if state in ["wrong","correct"] else "Passed answers are restored. First-attempt accuracy stays separate from eventual pass." if state=="resumed" else "Answer could not be saved. Retry; no capstone completion is confirmed.","tone":"error" if state in ["wrong","save_error"] else "neutral","can_close":state!="save_error"})
	page("pause.open","Paused","Take your time. Learning help is free.",[action("resume","Resume"),action("save_menu","Save & Menu")],{"rows":[{"title":"Guides","text":"Lessons and demonstrations","action":"guides"},{"title":"Journal","text":"Discoveries, ranks and achievements","action":"journal"},{"title":"Travel","text":"Previously attuned checkpoints","action":"travel"},{"title":"Settings","text":"Audio and accessibility","action":"settings"}]})
	for state in ["empty","known","locked"]:
		page("travel."+state,"Checkpoint travel","Only previously attuned destinations are available. Travel is not a lesson or a progression unlock.",[action("return","Return")],{"rows":[{"id":"C1","title":"Attuned checkpoint","text":"Safe destination supplied by the world","action":"request_travel","enabled":state=="known"}] if state!="empty" else [],"status":"No destinations attuned" if state=="empty" else "Destination unavailable" if state=="locked" else "Previously attuned destination"})
	for state in ["empty","valid","saving","error"]:
		page("profile."+state,"Your explorer name","Enter your name first." if state=="empty" else "Your name could not be saved. Retry; your previous name is retained." if state=="error" else "Choose a name for your adventure.",[action("save_name","Save name",state not in ["empty","saving"]),action("return","Back",state!="saving")],{"field":{"value":"Ari" if state!="empty" else ""},"status":"Saving…" if state=="saving" else "","can_close":state!="saving","origin":"Existing set_player_name trims to24characters and rejects empty; presentation does not save"})
	for state in ["default","accessible","muted"]:
		page("settings."+state,"Settings","Adjust audio and choose comfortable text, contrast and motion.",[action("return","Return")],{"settings":[{"id":"music","label":"Music","value":state!="muted"},{"id":"sfx","label":"Sound effects","value":state!="muted"},{"id":"reduced_effects","label":"Reduced effects","value":state=="accessible"},{"id":"reduced_motion","label":"Reduced motion","value":state=="accessible"},{"id":"large_text","label":"Larger text","value":state=="accessible"},{"id":"high_contrast","label":"Higher contrast","value":state=="accessible"}],"large_text":state=="accessible","high_contrast":state=="accessible","reduced_motion":state=="accessible"})
	for state in ["checkpoint","restart_confirm","save_failed","backup_available","backup_missing","unknown_version","unsaved_confirm"]:
		var body: String={"checkpoint":"Return to the newest unlocked checkpoint in this subregion. Completed work stays committed.","restart_confirm":"Restart this attempt? Review what will reset before confirming. Existing earned profile progress is preserved.","save_failed":"Progress could not be saved. Retry. The previous valid save remains available; success has not been confirmed.","backup_available":"A recovery copy is available. Review it before restoring; keep the current file until recovery succeeds.","backup_missing":"No recovery copy is available. Return safely; do not reset the profile automatically.","unknown_version":"This save uses an unsupported version. Keep it unchanged and return to the menu.","unsaved_confirm":"Changes have not been saved. Retry saving or stay here before leaving."}[state]
		page("recovery."+state,"Recovery" if state=="checkpoint" else "Confirm restart" if state=="restart_confirm" else "Save needs attention",body,[action("recover","Return to checkpoint") if state=="checkpoint" else action("confirm_restart","Restart attempt") if state=="restart_confirm" else action("restore_backup","Review recovery copy") if state=="backup_available" else action("retry_save","Retry save",state not in ["unknown_version","backup_missing"]),action("cancel","Stay here" if state=="unsaved_confirm" else "Back")],{"tone":"error" if state in ["save_failed","backup_missing","unknown_version","unsaved_confirm"] else "neutral"})
	for state in ["saving","success","already_complete","campaign_complete","error"]:
		page("completion."+state,"Adventure complete" if state=="campaign_complete" else "Subregion complete",{"saving":"Saving verified progress. Please wait for confirmation.","success":"Your completed work has been saved. Continue exploring unlocked routes.","already_complete":"This completion is already recorded. Replaying does not duplicate its star or rewards.","campaign_complete":"The final scanner task is complete. You can return to the world or revisit discoveries in the Journal.","error":"Completion could not be saved. Retry before leaving; no unlock or reward is confirmed."}[state],[action("retry_save","Retry save") if state=="error" else action("return_world","Return to world",state!="saving"),action("journal","Journal",state not in ["saving","error"])],{"status":"Not saved" if state=="error" else "Saving…" if state=="saving" else "Committed progress","can_close":state not in ["saving","error"],"tone":"error" if state=="error" else "success"})
	for state in ["entry","resume","unanswered","answered","review","submit_confirm","submitting","error","submitted","explanations","unavailable"]:
		var body: String={"entry":"Study Assessment is separate from adventure progress, rewards and free-help practice. Use the pre/post form assigned by your researcher.","resume":"An unfinished assessment is available. Continue the same session rather than starting another first attempt.","unanswered":question.text,"answered":question.text,"review":"Review your responses before submission. No correctness hints are shown during the assessment.","submit_confirm":"Submit these responses? This creates a distinct submitted attempt; it does not grant adventure progress.","submitting":"Saving the submitted assessment. Wait for confirmation.","error":"Assessment submission could not be saved. Your responses remain available. Retry without starting another first attempt.","submitted":"Assessment submitted. Scores remain separate from stars, badges and Finn progression.","explanations":question.feedback,"unavailable":"The assigned study form is not available. Ask your researcher for the validated form or paper assessment."}[state]
		page("assessment."+state,"Study Assessment",body,[action("resume_assessment","Resume") if state=="resume" else action("submit_assessment","Submit responses") if state=="submit_confirm" else action("retry_assessment","Retry submission") if state=="error" else action("next_item","Next",state!="unavailable") if state in ["unanswered","answered"] else action("review_form","Review responses",state not in ["submitting","unavailable"]),action("return","Return",state!="submitting")],{"choices":choices if state in ["unanswered","answered"] else [],"selected_choice":"1" if state=="answered" else "","status":"Item 1 / 12" if state in ["unanswered","answered"] else "Submitted review" if state=="explanations" else "Pre / post form","can_close":state!="submitting","origin":"R3 proposed12iteminstrument layouts; actual L1 text is specimen only, no validated pre/post bank or scoring/persistence implemented"})
	panels["assessment.submitted"].rows=[{"title":"Submitted result","text":"8 / 12"},{"title":"Assigned form","text":"Pre-test · instrument version 1"},{"title":"Attempt","text":"Submitted local study session"}]
	write("panels.json",{"schema_version":1,"owner":"R3 010","scope":"Opt-in asset/default-state catalog; provider-supplied content remains authoritative","panels":panels,"science_routes":RULES.PROCESSES,"cast_roles":cast.keys(),"future_integration":"015/023/046/047; no live learning/save/assessment logic"})
	print("R3 010 CONTENT / ",panels.size()," panel states / ",BADGES.DEFINITIONS.size()," original badge IDs / ",QUESTIONS.BANKS.size()," original question banks")
	quit()
